# ==============================================================================
# Managed PostgreSQL Connection (e.g. Neon or Supabase)
# ==============================================================================
# Use a pooled connection URL for application runtime queries:
DATABASE_URL="postgresql://neondb_owner:YOUR_DEV_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Use a direct, unpooled connection URL for running Prisma migrations:
DIRECT_URL="postgresql://neondb_owner:YOUR_DEV_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# JWT Authentication Configuration
# ==============================================================================
JWT_SECRET="dev-insecure-jwt-secret-replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="dev-insecure-jwt-refresh-secret-replace-with-32-characters"
JWT_REFRESH_EXPIRES_IN="7d"

# ==============================================================================
# Service Ports & URLs
# ==============================================================================
PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
WEB_URL="http://localhost:3000"

# ==============================================================================
# Application Defaults
# ==============================================================================
DEFAULT_TIMEZONE="Asia/Kolkata"
NODE_ENV="development"
