{
  "name": "hrms-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @hrms/database run generate",
    "db:migrate": "pnpm --filter @hrms/database run migrate",
    "db:seed": "pnpm --filter @hrms/database run seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.3"
  },
  "packageManager": "pnpm@12.10.1"
}
